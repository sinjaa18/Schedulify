# Server-side only. Never rename this with a VITE_ prefix.
OPENAI_API_KEY=

# PostgreSQL identity store (create a local database before running migrations)
DATABASE_URL=postgres://localhost:5432/schedulify
# Set true only when the PostgreSQL service requires TLS.
DATABASE_SSL=false
# Set true only behind HTTPS; production should use Secure cookies.
COOKIE_SECURE=false
# Exact browser origin; use the dev server origin locally and the HTTPS origin in production.
PUBLIC_APP_ORIGIN=http://localhost:5173
# Optional API settings
# API_PORT=3001
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-4o-mini
