# Copy to .env.test and point at a disposable local database ending in _test.
TEST_DATABASE_URL=postgres://schedulify_test:schedulify_test@127.0.0.1:55432/schedulify_test
TEST_DATABASE_SSL=false
# E2E uses a separate isolated schema in its disposable *_test database.
E2E_DATABASE_URL=postgres://schedulify_test:schedulify_test@127.0.0.1:55432/schedulify_test
E2E_DATABASE_SSL=false
